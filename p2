package com.citi.olympus.gru.dataconnector.util

import org.apache.spark.sql.functions._
import org.apache.spark.sql.types._
import org.apache.spark.sql.{Column, DataFrame, SparkSession}

object AvroJsonCsvUtility {

  final case class CsvWriteConfig(
      outputPath: String,
      mode: String,
      header: String,
      delimiter: String,
      quote: String,
      escape: String,
      nullValue: String,
      multiLine: String,
      stripRootPrefixes: Seq[String]
  )

  /**
    * Converts the decoded Avro struct into a CSV-ready DataFrame.
    *
    * Structs are flattened recursively.
    * Array[Struct] columns are exploded and their resulting structs are flattened.
    * Remaining primitive arrays and maps are serialized as JSON strings because
    * CSV cannot represent them as native values.
    */
  def toFlattenedCsvReadyDF(
      spark: SparkSession,
      decodeSuccessDF: DataFrame,
      stripRootPrefixes: Seq[String]
  ): DataFrame = {

    require(
      decodeSuccessDF.columns.contains("decoded_record"),
      "Input DataFrame must contain a decoded_record column"
    )

    val decodedStructDF = decodeSuccessDF.select(col("decoded_record.*"))

    val flattenedDF = normalizeForCsv(
      decodedStructDF,
      stripRootPrefixes
    )

    validateNoStructOrArrayOfStructColumns(flattenedDF)
    validateNoDuplicateColumns(flattenedDF)

    convertRemainingComplexColumnsToJson(flattenedDF)
  }

  def writeCsv(df: DataFrame, config: CsvWriteConfig): Unit = {
    validateNoStructOrArrayOfStructColumns(df)
    validateNoDuplicateColumns(df)

    val orderedColumns: Seq[Column] =
      df.columns.toSeq.map(name => col(quoted(name)))

    df.select(orderedColumns: _*)
      .write
      .mode(config.mode)
      .option("header", config.header)
      .option("sep", config.delimiter)
      .option("quote", config.quote)
      .option("escape", config.escape)
      .option("nullValue", config.nullValue)
      .option("multiLine", config.multiLine)
      .csv(config.outputPath)
  }

  /**
    * Repeatedly flattens all top-level StructType columns until no StructType
    * column remains.
    */
  private def flattenStructColumns(
      df: DataFrame,
      stripRootPrefixes: Seq[String]
  ): DataFrame = {

    def flattenOnce(currentDF: DataFrame): DataFrame = {
      val projectedColumns: Seq[Column] =
        currentDF.schema.fields.toSeq.flatMap { field =>
          field.dataType match {
            case structType: StructType =>
              structType.fields.toSeq.map { child =>
                val rawName = joinColumnPath(field.name, child.name)
                val normalizedName =
                  normalizeColumnPath(rawName, stripRootPrefixes)

                col(
                  s"${quoted(field.name)}.${quoted(child.name)}"
                ).as(normalizedName)
              }

            case _ =>
              Seq(col(quoted(field.name)))
          }
        }

      currentDF.select(projectedColumns: _*)
    }

    @scala.annotation.tailrec
    def loop(currentDF: DataFrame): DataFrame = {
      val hasStruct = currentDF.schema.fields.exists {
        field => field.dataType.isInstanceOf[StructType]
      }

      if (!hasStruct) {
        currentDF
      } else {
        loop(flattenOnce(currentDF))
      }
    }

    loop(df)
  }

  /**
    * Correct normalization loop.
    *
    * Important: exploding Array[Struct] produces a StructType column. Therefore,
    * after every explode operation this method recurses and runs struct flattening
    * again. The previous implementation returned too early and later converted
    * that struct back to a JSON string.
    */
  @scala.annotation.tailrec
  private def normalizeForCsv(
      df: DataFrame,
      stripRootPrefixes: Seq[String]
  ): DataFrame = {

    val flattenedStructDF =
      flattenStructColumns(df, stripRootPrefixes)

    findFirstArrayOfStructColumn(flattenedStructDF) match {
      case Some(columnName) =>
        val explodedDF = flattenedStructDF.withColumn(
          columnName,
          explode_outer(col(quoted(columnName)))
        )

        normalizeForCsv(explodedDF, stripRootPrefixes)

      case None =>
        flattenedStructDF
    }
  }

  private def findFirstArrayOfStructColumn(
      df: DataFrame
  ): Option[String] = {
    df.schema.fields.collectFirst {
      case StructField(
            fieldName,
            ArrayType(_: StructType, _),
            _,
            _
          ) =>
        fieldName
    }
  }

  /**
    * At this point there must be no StructType or Array[Struct] column.
    * Primitive arrays and maps are kept in one CSV cell as valid JSON text.
    */
  private def convertRemainingComplexColumnsToJson(
      df: DataFrame
  ): DataFrame = {

    val projectedColumns: Seq[Column] =
      df.schema.fields.toSeq.map { field =>
        field.dataType match {
          case _: StructType =>
            throw new IllegalStateException(
              s"Struct column '${field.name}' remains after flattening"
            )

          case ArrayType(_: StructType, _) =>
            throw new IllegalStateException(
              s"Array[Struct] column '${field.name}' remains after flattening"
            )

          case _: ArrayType =>
            to_json(col(quoted(field.name))).as(field.name)

          case _: MapType =>
            to_json(col(quoted(field.name))).as(field.name)

          case _ =>
            col(quoted(field.name))
        }
      }

    df.select(projectedColumns: _*)
  }

  private def validateNoStructOrArrayOfStructColumns(
      df: DataFrame
  ): Unit = {
    val invalidColumns = df.schema.fields.toSeq.collect {
      case StructField(name, _: StructType, _, _) =>
        s"$name: StructType"

      case StructField(name, ArrayType(_: StructType, _), _, _) =>
        s"$name: Array[Struct]"
    }

    if (invalidColumns.nonEmpty) {
      throw new IllegalStateException(
        "Flattening is incomplete. Remaining complex columns: " +
          invalidColumns.mkString(", ")
      )
    }
  }

  private def validateNoDuplicateColumns(df: DataFrame): Unit = {
    val duplicateColumns =
      df.columns
        .groupBy(identity)
        .collect {
          case (name, occurrences) if occurrences.length > 1 => name
        }
        .toSeq
        .sorted

    if (duplicateColumns.nonEmpty) {
      throw new IllegalStateException(
        "Flattening produced duplicate CSV column names: " +
          duplicateColumns.mkString(", ")
      )
    }
  }

  private def joinColumnPath(prefix: String, name: String): String = {
    if (prefix == null || prefix.isEmpty) name
    else s"${prefix}_${name}"
  }

  private def normalizeColumnPath(
      path: String,
      stripRootPrefixes: Seq[String]
  ): String = {

    val normalized = stripRootPrefixes.foldLeft(path) {
      case (current, root) if root == null || root.isEmpty =>
        current

      case (current, root) if current == root =>
        ""

      case (current, root) if current.startsWith(root + "_") =>
        current.substring(root.length + 1)

      case (current, _) =>
        current
    }

    if (normalized.isEmpty) path else normalized
  }

  /** Quotes a Spark column identifier safely. */
  private def quoted(columnName: String): String =
    s"`${columnName.replace("`", "``")}`"
}
