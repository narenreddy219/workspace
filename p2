package com.citi.olympus.gru.dataconnector.util

import org.apache.spark.sql.functions._
import org.apache.spark.sql.types._
import org.apache.spark.sql.{Column, DataFrame, SparkSession}

object AvroJsonCsvUtility {

  final case class CsvWriteConfig(
      outputPath: String,
      mode: String,
      header: String,
      delimiter: String,
      quote: String,
      escape: String,
      nullValue: String,
      multiLine: String,
      stripRootPrefixes: Seq[String]
  )

  /**
    * Converts the decoded Avro struct into a CSV-ready DataFrame.
    *
    * Structs are flattened recursively.
    * Array[Struct] columns are exploded and their resulting structs are flattened.
    * Remaining primitive arrays and maps are serialized as JSON strings because
    * CSV cannot represent them as native values.
    */
  def toFlattenedCsvReadyDF(
      spark: SparkSession,
      decodeSuccessDF: DataFrame,
      stripRootPrefixes: Seq[String]
  ): DataFrame = {

    require(
      decodeSuccessDF.columns.contains("decoded_record"),
      "Input DataFrame must contain a decoded_record column"
    )

    val decodedStructDF = decodeSuccessDF.select(col("decoded_record.*"))

    val flattenedDF = normalizeForCsv(
      decodedStructDF,
      stripRootPrefixes
    )

    validateNoStructOrArrayOfStructColumns(flattenedDF)
    validateNoDuplicateColumns(flattenedDF)

    convertRemainingComplexColumnsToJson(flattenedDF)
  }

  def writeCsv(df: DataFrame, config: CsvWriteConfig): Unit = {
    validateNoStructOrArrayOfStructColumns(df)
    validateNoDuplicateColumns(df)

    val orderedColumns: Seq[Column] =
      df.columns.toSeq.map(name => col(quoted(name)))

    df.select(orderedColumns: _*)
      .write
      .mode(config.mode)
      .option("header", config.header)
      .option("sep", config.delimiter)
      .option("quote", config.quote)
      .option("escape", config.escape)
      .option("nullValue", config.nullValue)
      .option("multiLine", config.multiLine)
      .csv(config.outputPath)
  }

  /**
    * Repeatedly flattens all top-level StructType columns until no StructType
    * column remains.
    */
  private def flattenStructColumns(
      df: DataFrame,
      stripRootPrefixes: Seq[String]
  ): DataFrame = {

    def flattenOnce(currentDF: DataFrame): DataFrame = {
      val projectedColumns: Seq[Column] =
        currentDF.schema.fields.toSeq.flatMap { field =>
          field.dataType match {
            case structType: StructType =>
              structType.fields.toSeq.map { child =>
                val rawName = joinColumnPath(field.name, child.name)
                val normalizedName =
                  normalizeColumnPath(rawName, stripRootPrefixes)

                col(
                  s"${quoted(field.name)}.${quoted(child.name)}"
                ).as(normalizedName)
              }

            case _ =>
              Seq(col(quoted(field.name)))
          }
        }

      currentDF.select(projectedColumns: _*)
    }

    @scala.annotation.tailrec
    def loop(currentDF: DataFrame): DataFrame = {
      val hasStruct = currentDF.schema.fields.exists {
        field => field.dataType.isInstanceOf[StructType]
      }

      if (!hasStruct) {
        currentDF
      } else {
        loop(flattenOnce(currentDF))
      }
    }

    loop(df)
  }

  /**
    * Correct normalization loop.
    *
    * Important: exploding Array[Struct] produces a StructType column. Therefore,
    * after every explode operation this method recurses and runs struct flattening
    * again. The previous implementation returned too early and later converted
    * that struct back to a JSON string.
    */
  @scala.annotation.tailrec
  private def normalizeForCsv(
      df: DataFrame,
      stripRootPrefixes: Seq[String]
  ): DataFrame = {

    val flattenedStructDF =
      flattenStructColumns(df, stripRootPrefixes)

    findFirstArrayOfStructColumn(flattenedStructDF) match {
      case Some(columnName) =>
        val explodedDF = flattenedStructDF.withColumn(
          columnName,
          explode_outer(col(quoted(columnName)))
        )

        normalizeForCsv(explodedDF, stripRootPrefixes)

      case None =>
        flattenedStructDF
    }
  }

  private def findFirstArrayOfStructColumn(
      df: DataFrame
  ): Option[String] = {
    df.schema.fields.collectFirst {
      case StructField(
            fieldName,
            ArrayType(_: StructType, _),
            _,
            _
          ) =>
        fieldName
    }
  }

  /**
    * At this point there must be no StructType or Array[Struct] column.
    * Primitive arrays and maps are kept in one CSV cell as valid JSON text.
    */
  private def convertRemainingComplexColumnsToJson(
      df: DataFrame
  ): DataFrame = {

    val projectedColumns: Seq[Column] =
      df.schema.fields.toSeq.map { field =>
        field.dataType match {
          case _: StructType =>
            throw new IllegalStateException(
              s"Struct column '${field.name}' remains after flattening"
            )

          case ArrayType(_: StructType, _) =>
            throw new IllegalStateException(
              s"Array[Struct] column '${field.name}' remains after flattening"
            )

          case _: ArrayType =>
            to_json(col(quoted(field.name))).as(field.name)

          case _: MapType =>
            to_json(col(quoted(field.name))).as(field.name)

          case _ =>
            col(quoted(field.name))
        }
      }

    df.select(projectedColumns: _*)
  }

  private def validateNoStructOrArrayOfStructColumns(
      df: DataFrame
  ): Unit = {
    val invalidColumns = df.schema.fields.toSeq.collect {
      case StructField(name, _: StructType, _, _) =>
        s"$name: StructType"

      case StructField(name, ArrayType(_: StructType, _), _, _) =>
        s"$name: Array[Struct]"
    }

    if (invalidColumns.nonEmpty) {
      throw new IllegalStateException(
        "Flattening is incomplete. Remaining complex columns: " +
          invalidColumns.mkString(", ")
      )
    }
  }

  private def validateNoDuplicateColumns(df: DataFrame): Unit = {
    val duplicateColumns =
      df.columns
        .groupBy(identity)
        .collect {
          case (name, occurrences) if occurrences.length > 1 => name
        }
        .toSeq
        .sorted

    if (duplicateColumns.nonEmpty) {
      throw new IllegalStateException(
        "Flattening produced duplicate CSV column names: " +
          duplicateColumns.mkString(", ")
      )
    }
  }

  private def joinColumnPath(prefix: String, name: String): String = {
    if (prefix == null || prefix.isEmpty) name
    else s"${prefix}_${name}"
  }

  private def normalizeColumnPath(
      path: String,
      stripRootPrefixes: Seq[String]
  ): String = {

    val normalized = stripRootPrefixes.foldLeft(path) {
      case (current, root) if root == null || root.isEmpty =>
        current

      case (current, root) if current == root =>
        ""

      case (current, root) if current.startsWith(root + "_") =>
        current.substring(root.length + 1)

      case (current, _) =>
        current
    }

    if (normalized.isEmpty) path else normalized
  }

  /** Quotes a Spark column identifier safely. */
  private def quoted(columnName: String): String =
    s"`${columnName.replace("`", "``")}`"
}






package com.citi.olympus.gru.dataconnector.util

import java.util.{Collections, Properties}
import java.util.concurrent.TimeUnit

import org.apache.kafka.clients.admin.{AdminClient, AdminClientConfig, OffsetSpec}
import org.apache.kafka.common.TopicPartition
import org.apache.spark.sql.functions._
import org.apache.spark.sql.{DataFrame, SparkSession}

import scala.collection.JavaConverters._
import scala.collection.mutable

/**
  * Bounded Kafka smoke test.
  *
  * It reads only the last N records from each partition and then exits. This is
  * intentionally a batch read (`spark.read`), not a streaming read
  * (`spark.readStream`), so the test does not run forever.
  *
  * Required arguments:
  *   --bootstrap host1:9092,host2:9092
  *   --topic topic-name
  *
  * Optional arguments:
  *   --records-per-partition 20
  *   --show-rows 50
  *   --security-protocol SASL_SSL
  *   --sasl-mechanism GSSAPI
  *   --sasl-jaas-config-env KAFKA_SASL_JAAS_CONFIG
  *   --ssl-truststore-location /path/to/truststore.jks
  *   --ssl-truststore-password-env KAFKA_TRUSTSTORE_PASSWORD
  *   --request-timeout-ms 30000
  *   --kafka-option sasl.kerberos.service.name=kafka
  *
  * Credentials are read from environment variables rather than command-line
  * arguments so they are not exposed in the process list.
  */
object KafkaBootstrapBatchSmokeTest {

  final case class Config(
      bootstrapServers: String,
      topic: String,
      recordsPerPartition: Long = 20L,
      showRows: Int = 50,
      securityProtocol: Option[String] = None,
      saslMechanism: Option[String] = None,
      saslJaasConfig: Option[String] = None,
      sslTruststoreLocation: Option[String] = None,
      sslTruststorePassword: Option[String] = None,
      requestTimeoutMs: Int = 30000,
      extraKafkaOptions: Map[String, String] = Map.empty
  )

  private final case class PartitionRange(
      partition: Int,
      earliest: Long,
      start: Long,
      end: Long
  ) {
    def recordCount: Long = math.max(0L, end - start)
  }

  def main(args: Array[String]): Unit = {
    val config = parseArgs(args)

    val spark = SparkSession.builder()
      .appName(s"KafkaBootstrapBatchSmokeTest-${config.topic}")
      .getOrCreate()

    spark.sparkContext.setLogLevel("WARN")

    try {
      val kafkaDF = readLastRecords(spark, config).cache()
      val recordCount = kafkaDF.count()

      println(s"Kafka connection succeeded for topic '${config.topic}'.")
      println(s"Records returned by the bounded test: $recordCount")

      kafkaDF
        .select(
          col("topic"),
          col("partition"),
          col("offset"),
          col("timestamp"),
          length(col("key")).as("key_bytes"),
          length(col("value")).as("value_bytes"),
          base64(col("key")).as("key_base64"),
          sha2(col("value"), 256).as("value_sha256")
        )
        .orderBy(col("partition"), col("offset"))
        .show(config.showRows, truncate = false)

      if (recordCount == 0L) {
        println(
          "Connection and topic metadata lookup succeeded, but no records " +
            "were available in the selected offset ranges."
        )
      }

      kafkaDF.unpersist()
    } finally {
      spark.stop()
    }
  }

  /**
    * Returns a finite DataFrame containing at most the last N records from each
    * partition as measured when the test starts.
    */
  def readLastRecords(
      spark: SparkSession,
      config: Config
  ): DataFrame = {
    require(config.bootstrapServers.trim.nonEmpty, "bootstrapServers is required")
    require(config.topic.trim.nonEmpty, "topic is required")
    require(config.recordsPerPartition > 0L, "recordsPerPartition must be greater than zero")

    val ranges = discoverPartitionRanges(config)

    if (ranges.isEmpty) {
      throw new IllegalStateException(
        s"Topic '${config.topic}' has no partitions"
      )
    }

    println("Bounded Kafka ranges selected for this test:")
    ranges.foreach { range =>
      println(
        s"  partition=${range.partition}, earliest=${range.earliest}, " +
          s"start=${range.start}, end=${range.end}, " +
          s"records=${range.recordCount}"
      )
    }

    val assignJson = buildAssignJson(config.topic, ranges)
    val startingOffsetsJson = buildOffsetsJson(config.topic, ranges, _.start)
    val endingOffsetsJson = buildOffsetsJson(config.topic, ranges, _.end)

    val reader = spark.read
      .format("kafka")
      .option("kafka.bootstrap.servers", config.bootstrapServers)
      .option("assign", assignJson)
      .option("startingOffsets", startingOffsetsJson)
      .option("endingOffsets", endingOffsetsJson)
      .option("failOnDataLoss", "false")

    val configuredReader = sparkKafkaOptions(config).foldLeft(reader) {
      case (currentReader, (key, value)) =>
        currentReader.option(key, value)
    }

    configuredReader.load()
  }

  private def discoverPartitionRanges(
      config: Config
  ): Seq[PartitionRange] = {
    val properties = adminClientProperties(config)
    val adminClient = AdminClient.create(properties)

    try {
      val topicDescriptions = adminClient
        .describeTopics(Collections.singletonList(config.topic))
        .all()
        .get(config.requestTimeoutMs.toLong, TimeUnit.MILLISECONDS)

      val topicDescription = Option(topicDescriptions.get(config.topic))
        .getOrElse(
          throw new IllegalStateException(
            s"Kafka did not return metadata for topic '${config.topic}'"
          )
        )

      val topicPartitions = topicDescription.partitions().asScala
        .map(info => new TopicPartition(config.topic, info.partition()))
        .sortBy(_.partition())
        .toSeq

      val earliestRequest = topicPartitions
        .map(topicPartition => topicPartition -> OffsetSpec.earliest())
        .toMap
        .asJava

      val latestRequest = topicPartitions
        .map(topicPartition => topicPartition -> OffsetSpec.latest())
        .toMap
        .asJava

      val earliestOffsets = adminClient
        .listOffsets(earliestRequest)
        .all()
        .get(config.requestTimeoutMs.toLong, TimeUnit.MILLISECONDS)
        .asScala
        .map { case (topicPartition, resultInfo) =>
          topicPartition -> resultInfo.offset()
        }
        .toMap

      val latestOffsets = adminClient
        .listOffsets(latestRequest)
        .all()
        .get(config.requestTimeoutMs.toLong, TimeUnit.MILLISECONDS)
        .asScala
        .map { case (topicPartition, resultInfo) =>
          topicPartition -> resultInfo.offset()
        }
        .toMap

      topicPartitions.map { topicPartition =>
        val earliest = earliestOffsets(topicPartition)
        val end = latestOffsets(topicPartition)
        val start = math.max(earliest, end - config.recordsPerPartition)

        PartitionRange(
          partition = topicPartition.partition(),
          earliest = earliest,
          start = start,
          end = end
        )
      }
    } finally {
      adminClient.close()
    }
  }

  private def adminClientProperties(config: Config): Properties = {
    val properties = new Properties()

    properties.put(
      AdminClientConfig.BOOTSTRAP_SERVERS_CONFIG,
      config.bootstrapServers
    )
    properties.put(
      AdminClientConfig.CLIENT_ID_CONFIG,
      s"kafka-bootstrap-smoke-test-${System.currentTimeMillis()}"
    )
    properties.put(
      AdminClientConfig.REQUEST_TIMEOUT_MS_CONFIG,
      config.requestTimeoutMs.toString
    )
    properties.put(
      AdminClientConfig.DEFAULT_API_TIMEOUT_MS_CONFIG,
      config.requestTimeoutMs.toString
    )

    config.securityProtocol.foreach(value =>
      properties.put("security.protocol", value)
    )
    config.saslMechanism.foreach(value =>
      properties.put("sasl.mechanism", value)
    )
    config.saslJaasConfig.foreach(value =>
      properties.put("sasl.jaas.config", value)
    )
    config.sslTruststoreLocation.foreach(value =>
      properties.put("ssl.truststore.location", value)
    )
    config.sslTruststorePassword.foreach(value =>
      properties.put("ssl.truststore.password", value)
    )

    config.extraKafkaOptions.foreach {
      case (rawKey, value) =>
        properties.put(removeKafkaPrefix(rawKey), value)
    }

    properties
  }

  private def sparkKafkaOptions(config: Config): Map[String, String] = {
    val options = mutable.LinkedHashMap.empty[String, String]

    config.securityProtocol.foreach(value =>
      options += "kafka.security.protocol" -> value
    )
    config.saslMechanism.foreach(value =>
      options += "kafka.sasl.mechanism" -> value
    )
    config.saslJaasConfig.foreach(value =>
      options += "kafka.sasl.jaas.config" -> value
    )
    config.sslTruststoreLocation.foreach(value =>
      options += "kafka.ssl.truststore.location" -> value
    )
    config.sslTruststorePassword.foreach(value =>
      options += "kafka.ssl.truststore.password" -> value
    )

    config.extraKafkaOptions.foreach {
      case (rawKey, value) =>
        options += addKafkaPrefix(rawKey) -> value
    }

    options.toMap
  }

  private def buildAssignJson(
      topic: String,
      ranges: Seq[PartitionRange]
  ): String = {
    val partitions = ranges.sortBy(_.partition).map(_.partition).mkString(",")
    s"{\"${escapeJson(topic)}\":[$partitions]}"
  }

  private def buildOffsetsJson(
      topic: String,
      ranges: Seq[PartitionRange],
      offsetSelector: PartitionRange => Long
  ): String = {
    val offsets = ranges
      .sortBy(_.partition)
      .map(range => s"\"${range.partition}\":${offsetSelector(range)}")
      .mkString(",")

    s"{\"${escapeJson(topic)}\":{$offsets}}"
  }

  private def escapeJson(value: String): String =
    value
      .replace("\\", "\\\\")
      .replace("\"", "\\\"")

  private def addKafkaPrefix(key: String): String =
    if (key.startsWith("kafka.")) key else s"kafka.$key"

  private def removeKafkaPrefix(key: String): String =
    if (key.startsWith("kafka.")) key.substring("kafka.".length) else key

  private def requiredEnvironmentVariable(name: String): String = {
    sys.env.get(name).filter(_.nonEmpty).getOrElse(
      throw new IllegalArgumentException(
        s"Environment variable '$name' is not defined"
      )
    )
  }

  private def parseArgs(args: Array[String]): Config = {
    var bootstrapServers: Option[String] = None
    var topic: Option[String] = None
    var recordsPerPartition = 20L
    var showRows = 50
    var securityProtocol: Option[String] = None
    var saslMechanism: Option[String] = None
    var saslJaasConfig: Option[String] = None
    var sslTruststoreLocation: Option[String] = None
    var sslTruststorePassword: Option[String] = None
    var requestTimeoutMs = 30000
    var extraKafkaOptions = Map.empty[String, String]

    def argumentValue(index: Int, option: String): String = {
      if (index + 1 >= args.length) {
        throw new IllegalArgumentException(s"Missing value for $option")
      }
      args(index + 1)
    }

    var index = 0
    while (index < args.length) {
      args(index) match {
        case "--bootstrap" =>
          bootstrapServers = Some(argumentValue(index, "--bootstrap"))
          index += 2

        case "--topic" =>
          topic = Some(argumentValue(index, "--topic"))
          index += 2

        case "--records-per-partition" =>
          recordsPerPartition =
            argumentValue(index, "--records-per-partition").toLong
          index += 2

        case "--show-rows" =>
          showRows = argumentValue(index, "--show-rows").toInt
          index += 2

        case "--security-protocol" =>
          securityProtocol =
            Some(argumentValue(index, "--security-protocol"))
          index += 2

        case "--sasl-mechanism" =>
          saslMechanism = Some(argumentValue(index, "--sasl-mechanism"))
          index += 2

        case "--sasl-jaas-config-env" =>
          val environmentVariable =
            argumentValue(index, "--sasl-jaas-config-env")
          saslJaasConfig =
            Some(requiredEnvironmentVariable(environmentVariable))
          index += 2

        case "--ssl-truststore-location" =>
          sslTruststoreLocation =
            Some(argumentValue(index, "--ssl-truststore-location"))
          index += 2

        case "--ssl-truststore-password-env" =>
          val environmentVariable =
            argumentValue(index, "--ssl-truststore-password-env")
          sslTruststorePassword =
            Some(requiredEnvironmentVariable(environmentVariable))
          index += 2

        case "--request-timeout-ms" =>
          requestTimeoutMs =
            argumentValue(index, "--request-timeout-ms").toInt
          index += 2

        case "--kafka-option" =>
          val option = argumentValue(index, "--kafka-option")
          val equalsIndex = option.indexOf('=')

          if (equalsIndex <= 0) {
            throw new IllegalArgumentException(
              "--kafka-option must use key=value format"
            )
          }

          val key = option.substring(0, equalsIndex)
          val value = option.substring(equalsIndex + 1)
          extraKafkaOptions += key -> value
          index += 2

        case "--help" | "-h" =>
          printUsageAndExit()

        case unknown =>
          throw new IllegalArgumentException(
            s"Unknown argument '$unknown'. Use --help for usage."
          )
      }
    }

    Config(
      bootstrapServers = bootstrapServers.getOrElse(
        throw new IllegalArgumentException("--bootstrap is required")
      ),
      topic = topic.getOrElse(
        throw new IllegalArgumentException("--topic is required")
      ),
      recordsPerPartition = recordsPerPartition,
      showRows = showRows,
      securityProtocol = securityProtocol,
      saslMechanism = saslMechanism,
      saslJaasConfig = saslJaasConfig,
      sslTruststoreLocation = sslTruststoreLocation,
      sslTruststorePassword = sslTruststorePassword,
      requestTimeoutMs = requestTimeoutMs,
      extraKafkaOptions = extraKafkaOptions
    )
  }

  private def printUsageAndExit(): Nothing = {
    println(
      """
        |Usage:
        |  KafkaBootstrapBatchSmokeTest \\
        |    --bootstrap host1:9092,host2:9092 \\
        |    --topic topic-name \\
        |    [--records-per-partition 20] \\
        |    [--show-rows 50] \\
        |    [--security-protocol SASL_SSL] \\
        |    [--sasl-mechanism GSSAPI] \\
        |    [--sasl-jaas-config-env KAFKA_SASL_JAAS_CONFIG] \\
        |    [--ssl-truststore-location /path/to/truststore.jks] \\
        |    [--ssl-truststore-password-env KAFKA_TRUSTSTORE_PASSWORD] \\
        |    [--request-timeout-ms 30000] \\
        |    [--kafka-option key=value]
        |""".stripMargin
    )
    sys.exit(0)
  }
}





class AvroJsonCsvUtilityLocalBinaryTest
    extends AnyFunSuite
    with BeforeAndAfterAll {

  private var spark: SparkSession = _

  override protected def beforeAll(): Unit = {
    spark = SparkSession.builder()
      .appName("AvroJsonCsvUtilityLocalBinaryTest")
      .master("local[*]")
      .config("spark.ui.enabled", "false")
      .getOrCreate()

    spark.sparkContext.setLogLevel("WARN")
  }

  test("binary file should decode, flatten and write CSV") {

    val inputFile =
      sys.env("AVRO_BINARY_FILE")

    val outputPath =
      sys.env.getOrElse(
        "CSV_OUTPUT_PATH",
        "target/avro-json-csv-output"
      )

    /*
     * STEP 1:
     * Read the .bin file as Array[Byte].
     */
    val binaryDF =
      spark.read
        .format("binaryFile")
        .load(inputFile)
        .select(
          col("content").as("value")
        )

    println("[TEST] Binary file loaded")

    /*
     * STEP 2:
     * Build the same structure normally received from Kafka.
     */
    val kafkaLikeDF =
      binaryDF.select(
        lit("local-file-test").as("topic"),
        lit(1).as("partition"),
        lit(1128572L).as("offset"),
        current_timestamp().as("timestamp"),
        lit(null).cast("binary").as("key"),
        col("value")
      )

    kafkaLikeDF.printSchema()

    /*
     * STEP 3:
     * Pass the binary value through the existing AvroDecodeUtility.
     *
     * Use the actual public method already present in your class.
     */
    println("[TEST] Starting Avro decoding")

    val decodedDF =
      AvroDecodeUtility.decode(
        spark = spark,
        kafkaDF = kafkaLikeDF
      )

    println("[TEST] Avro decoding completed")

    decodedDF.printSchema()
    decodedDF.show(false)

    /*
     * Decoder output should contain:
     *
     * decoded_record: struct
     */
    assert(
      decodedDF.columns.contains("decoded_record"),
      "AvroDecodeUtility output must contain decoded_record"
    )

    /*
     * STEP 4:
     * Pass decoded_record through AvroJsonCsvUtility.
     */
    println("[TEST] Starting JSON flattening")

    val flattenedDF =
      AvroJsonCsvUtility.toFlattenedCsvReadyDF(
        spark = spark,
        decodeSuccessDF = decodedDF,
        stripRootPrefixes = Seq.empty
      )

    println("[TEST] Flattening completed")

    flattenedDF.printSchema()
    flattenedDF.show(false)

    /*
     * STEP 5:
     * Write the flattened DataFrame as CSV.
     */
    println("[TEST] Starting CSV write")

    AvroJsonCsvUtility.writeCsv(
      df = flattenedDF,
      config = AvroJsonCsvUtility.CsvWriteConfig(
        outputPath = outputPath,
        mode = "overwrite",
        header = "true",
        delimiter = ",",
        quote = "\"",
        escape = "\"",
        nullValue = "",
        multiLine = "false",
        stripRootPrefixes = Seq.empty
      )
    )

    println("[TEST] CSV write completed")

    /*
     * STEP 6:
     * Read the CSV back and validate it.
     */
    val resultDF =
      spark.read
        .option("header", "true")
        .csv(outputPath)

    resultDF.printSchema()
    resultDF.show(false)

    assert(resultDF.count() > 0)
    assert(resultDF.columns.nonEmpty)
  }

  override protected def afterAll(): Unit = {
    if (spark != null) {
      spark.stop()
    }
  }
}

